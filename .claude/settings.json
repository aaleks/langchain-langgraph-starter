{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPENSPEC_TELEMETRY": "0",
    "LANGSMITH_TRACING": "false",
    "LANGSMITH_TRACING_V2": "false",
    "LANGCHAIN_TRACING_V2": "false",
    "LANGCHAIN_TRACING": "false",
    "LANGSMITH_API_KEY": "",
    "LANGCHAIN_API_KEY": "",
    "LANGSMITH_CONTROL_PLANE_API_KEY": "",
    "LANGGRAPH_CLOUD_LICENSE_KEY": "",
    "LANGSMITH_ENDPOINT": "http://127.0.0.1:9",
    "LANGCHAIN_ENDPOINT": "http://127.0.0.1:9",
    "LANGGRAPH_CLI_NO_ANALYTICS": "1",
    "LANGGRAPH_NO_VERSION_CHECK": "true"
  },
  "permissions": {
    "allow": [
      "Bash(bash .claude/sdd/sdd.sh check*)",
      "Bash(bash .claude/sdd/sdd.sh status*)",
      "Bash(bash .claude/sdd/sdd.sh version*)",
      "Bash(bash .claude/sdd/sdd.sh selftest*)",
      "Bash(bash .claude/sdd/sdd.sh openspec status*)",
      "Bash(bash .claude/sdd/sdd.sh openspec validate*)",
      "Bash(bash .claude/sdd/sdd.sh openspec list*)",
      "Bash(bash .claude/sdd/sdd.sh openspec show*)",
      "Bash(bash .claude/sdd/sdd.sh openspec instructions*)",
      "Bash(bash scripts/check.sh*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff check*)",
      "Bash(uv run ruff format --check*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Bash(*smith.langchain.com*)",
      "Bash(*--studio-url*)",
      "Bash(*--tunnel*)",
      "Bash(*langgraph deploy*)",
      "Bash(*langgraph up*)",
      "Bash(*langgraph dev*)",
      "Bash(*langgraph_cli dev*)",
      "Bash(*langgraph-cli dev*)",
      "Bash(*langgraph_api.cli*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edits.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-alignment.sh\""
          }
        ]
      }
    ]
  }
}
