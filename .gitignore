# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments -- .env holds live credentials and is written by a human only
.venv/
venv/
.env
.env.*
!.env.example

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
node_modules/

# Claude Code: personal settings and local agent memory stay on your machine
.claude/settings.local.json
.claude/agent-memory-local/

# Generated by /quality on each run. A stale one is worse than none.
quality-report.md

# Mutation testing session files, regenerated by each run
mutation.sqlite
mutation.html

# LangGraph: the local server's threads, and checkpoint stores -- data, not
# source, and never evidence of anything when committed
.langgraph_api/
*.sqlite
*.sqlite3
*.db

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
